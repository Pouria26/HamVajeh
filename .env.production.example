# -----------------------------------------------------------------------------
# HamVajeh Production Environment Configuration
# Copy this file to .env.production or pass via environment variables in your VPS.
# -----------------------------------------------------------------------------

# PostgreSQL Database Configuration
POSTGRES_USER=hamvajeh
POSTGRES_PASSWORD=hamvajeh
POSTGRES_DB=hamvajeh
POSTGRES_PORT=5432

# Google Gemini API Key (Required for AI Tutor Agent)
# Get a key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Pydantic Logfire Observability Token (Optional)
# LOGFIRE_TOKEN=your_logfire_token_here

# Security Token for /api/admin panel (Generate a long secure secret)
# e.g.: openssl rand -hex 32
ADMIN_TOKEN=generate-a-strong-random-token-here

# Web Server Public Port (Default: 80)
PORT=80

# Allowed Frontend URL for CORS (Leave as * or specify your domain: https://example.com)
FRONTEND_URL=*
