{
  "name": "hamvajeh-backend",
  "version": "0.1.0",
  "description": "Backend for the HamVajeh Persian collocation learning system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "init-schema": "ts-node src/db/initSchema.ts",
    "import-csv": "ts-node src/importDataset.ts",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
